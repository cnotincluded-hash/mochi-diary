{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mochi Diary",
  "version": "1.0.0",
  "identifier": "com.caffeinenotincluded.mochidiary",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/make-dist.mjs",
    "beforeBuildCommand": "node scripts/make-dist.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mochi Diary",
        "width": 520,
        "height": 900,
        "minWidth": 380,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Lifestyle",
    "shortDescription": "A cute diary buddy that reads your day",
    "longDescription": "Mochi Diary is a pastel diary with a squishy mochi buddy. Write about your day and Mochi scores your joy, stress, social time, focus and energy, picks your vibe animal and shows your patterns over time. Everything is saved on your Mac.",
    "copyright": "Caffeine Not Included",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": { "width": 600, "height": 380 },
        "appPosition": { "x": 170, "y": 190 },
        "applicationFolderPosition": { "x": 430, "y": 190 }
      }
    }
  }
}
